# Copy to .env (gitignored). For EAS builds, set these with `eas env:create`
# (or in eas.json build profiles) — EXPO_PUBLIC_* values are baked into the app.
EXPO_PUBLIC_WORKER_URL=https://tallyshot-proxy.tallyshot.workers.dev
# RevenueCat public SDK keys (Project settings → API keys). Public keys are safe in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx
